{
  "description": "Greedy simplification: each round pays the largest remaining debtor to the largest remaining creditor (ties by member id), then looks again at what is left. At most people minus one payments.",
  "cases": [
    {
      "name": "two debtors, one creditor",
      "balances": {
        "00000000-0000-4000-8000-000000000001": 2000,
        "00000000-0000-4000-8000-000000000002": -1000,
        "00000000-0000-4000-8000-000000000003": -1000
      },
      "expected": [
        {
          "from": "00000000-0000-4000-8000-000000000002",
          "to": "00000000-0000-4000-8000-000000000001",
          "amount_minor": 1000
        },
        {
          "from": "00000000-0000-4000-8000-000000000003",
          "to": "00000000-0000-4000-8000-000000000001",
          "amount_minor": 1000
        }
      ]
    },
    {
      "name": "classic four people",
      "balances": {
        "00000000-0000-4000-8000-000000000001": 50,
        "00000000-0000-4000-8000-000000000002": 30,
        "00000000-0000-4000-8000-000000000003": -20,
        "00000000-0000-4000-8000-000000000004": -60
      },
      "expected": [
        {
          "from": "00000000-0000-4000-8000-000000000004",
          "to": "00000000-0000-4000-8000-000000000001",
          "amount_minor": 50
        },
        {
          "from": "00000000-0000-4000-8000-000000000003",
          "to": "00000000-0000-4000-8000-000000000002",
          "amount_minor": 20
        },
        {
          "from": "00000000-0000-4000-8000-000000000004",
          "to": "00000000-0000-4000-8000-000000000002",
          "amount_minor": 10
        }
      ]
    },
    {
      "name": "already settled",
      "balances": {
        "00000000-0000-4000-8000-000000000001": 0,
        "00000000-0000-4000-8000-000000000002": 0
      },
      "expected": []
    },
    {
      "name": "ties are broken by member id",
      "balances": {
        "00000000-0000-4000-8000-000000000001": 100,
        "00000000-0000-4000-8000-000000000002": 100,
        "00000000-0000-4000-8000-000000000003": -100,
        "00000000-0000-4000-8000-000000000004": -100
      },
      "expected": [
        {
          "from": "00000000-0000-4000-8000-000000000003",
          "to": "00000000-0000-4000-8000-000000000001",
          "amount_minor": 100
        },
        {
          "from": "00000000-0000-4000-8000-000000000004",
          "to": "00000000-0000-4000-8000-000000000002",
          "amount_minor": 100
        }
      ]
    },
    {
      "name": "a single pair",
      "balances": {
        "00000000-0000-4000-8000-000000000001": 500,
        "00000000-0000-4000-8000-000000000002": -500
      },
      "expected": [
        {
          "from": "00000000-0000-4000-8000-000000000002",
          "to": "00000000-0000-4000-8000-000000000001",
          "amount_minor": 500
        }
      ]
    },
    {
      "name": "equal debtors, uneven creditors",
      "balances": {
        "00000000-0000-4000-8000-000000000001": 30,
        "00000000-0000-4000-8000-000000000002": 20,
        "00000000-0000-4000-8000-000000000003": -25,
        "00000000-0000-4000-8000-000000000004": -25
      },
      "expected": [
        {
          "from": "00000000-0000-4000-8000-000000000003",
          "to": "00000000-0000-4000-8000-000000000001",
          "amount_minor": 25
        },
        {
          "from": "00000000-0000-4000-8000-000000000004",
          "to": "00000000-0000-4000-8000-000000000002",
          "amount_minor": 20
        },
        {
          "from": "00000000-0000-4000-8000-000000000004",
          "to": "00000000-0000-4000-8000-000000000001",
          "amount_minor": 5
        }
      ]
    },
    {
      "name": "a partial payment changes who is largest",
      "balances": {
        "00000000-0000-4000-8000-000000000001": 10,
        "00000000-0000-4000-8000-000000000002": 8,
        "00000000-0000-4000-8000-000000000003": -6,
        "00000000-0000-4000-8000-000000000004": -5,
        "00000000-0000-4000-8000-000000000005": -4,
        "00000000-0000-4000-8000-000000000006": -3
      },
      "expected": [
        {
          "from": "00000000-0000-4000-8000-000000000003",
          "to": "00000000-0000-4000-8000-000000000001",
          "amount_minor": 6
        },
        {
          "from": "00000000-0000-4000-8000-000000000004",
          "to": "00000000-0000-4000-8000-000000000002",
          "amount_minor": 5
        },
        {
          "from": "00000000-0000-4000-8000-000000000005",
          "to": "00000000-0000-4000-8000-000000000001",
          "amount_minor": 4
        },
        {
          "from": "00000000-0000-4000-8000-000000000006",
          "to": "00000000-0000-4000-8000-000000000002",
          "amount_minor": 3
        }
      ]
    },
    {
      "name": "tied remainders go to the smaller id",
      "balances": {
        "00000000-0000-4000-8000-000000000001": 6,
        "00000000-0000-4000-8000-000000000002": 6,
        "00000000-0000-4000-8000-000000000003": -4,
        "00000000-0000-4000-8000-000000000004": -4,
        "00000000-0000-4000-8000-000000000005": -4
      },
      "expected": [
        {
          "from": "00000000-0000-4000-8000-000000000003",
          "to": "00000000-0000-4000-8000-000000000001",
          "amount_minor": 4
        },
        {
          "from": "00000000-0000-4000-8000-000000000004",
          "to": "00000000-0000-4000-8000-000000000002",
          "amount_minor": 4
        },
        {
          "from": "00000000-0000-4000-8000-000000000005",
          "to": "00000000-0000-4000-8000-000000000001",
          "amount_minor": 2
        },
        {
          "from": "00000000-0000-4000-8000-000000000005",
          "to": "00000000-0000-4000-8000-000000000002",
          "amount_minor": 2
        }
      ]
    }
  ]
}
